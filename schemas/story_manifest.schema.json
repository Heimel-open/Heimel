{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valoresearch.org/schemas/story_manifest.schema.json",
  "title": "VALO Story Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "title", "slides"],
  "properties": {
    "schema": {"const": "valo.story-manifest.v1"},
    "title": {"type": "string", "minLength": 1},
    "subtitle": {"type": "string"},
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background": {"type": "string", "pattern": "^#?[0-9A-Fa-f]{6}$"},
        "foreground": {"type": "string", "pattern": "^#?[0-9A-Fa-f]{6}$"},
        "accent": {"type": "string", "pattern": "^#?[0-9A-Fa-f]{6}$"},
        "muted": {"type": "string", "pattern": "^#?[0-9A-Fa-f]{6}$"}
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "kicker": {"type": "string"},
          "body": {"type": "array", "items": {"type": "string"}},
          "footer": {"type": "string"}
        }
      }
    }
  }
}
