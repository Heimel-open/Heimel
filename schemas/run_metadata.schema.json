{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "run_metadata",
  "type": "object",
  "required": ["run_id", "issue_id", "agent_id", "base_sha", "branch", "worktree", "authority", "state", "created_at"],
  "properties": {
    "run_id": {"type": "string"},
    "issue_id": {"type": "string"},
    "agent_id": {"type": "string"},
    "base_sha": {"type": "string"},
    "branch": {"type": "string"},
    "worktree": {"type": "string"},
    "authority": {"type": "string", "enum": ["read_write", "read_only", "dry"]},
    "lease_expires": {"type": "string"},
    "state": {"type": "string", "enum": ["IMPLEMENTING", "PLANNED", "QC", "BLOCKED", "MERGED", "CANCELLED"]},
    "created_at": {"type": "string"}
  }
}
