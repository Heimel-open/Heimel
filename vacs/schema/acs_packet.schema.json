{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ACS Packet v0.1 (HISTORICAL, superseded by RACS)",
  "type": "object",
  "required": [
    "acs_version",
    "packet_id",
    "agent_id",
    "timestamp",
    "intent",
    "evidence",
    "risk",
    "confidence",
    "policy",
    "decision"
  ],
  "properties": {
    "acs_version": {
      "type": "string",
      "enum": ["0.1"]
    },
    "packet_id": {
      "type": "string",
      "format": "uuid"
    },
    "agent_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "intent": {
      "type": "object",
      "required": ["action", "target"],
      "properties": {
        "action": {"type": "string"},
        "target": {"type": "string"},
        "scope": {"type": "string"}
      }
    },
    "evidence": {
      "type": "object",
      "required": ["sources"],
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["hash", "type"],
            "properties": {
              "hash": {"type": "string"},
              "type": {
                "type": "string",
                "enum": [
                  "document",
                  "policy",
                  "data",
                  "test_result",
                  "human_input",
                  "recipient",
                  "content",
                  "account",
                  "authorization",
                  "code_review",
                  "backup_confirmation"
                ]
              },
              "uri": {"type": "string"},
              "verified": {"type": "boolean", "default": false}
            }
          }
        },
        "evidence_gap": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "risk": {
      "type": "object",
      "required": ["level"],
      "properties": {
        "level": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "categories": {
          "type": "array",
          "items": {"type": "string"}
        },
        "blast_radius": {
          "type": "string",
          "enum": ["single_document", "single_user", "organization", "system_wide"]
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "policy": {
      "type": "object",
      "required": ["required_signoff", "max_risk_level", "evidence_gap_threshold"],
      "properties": {
        "required_signoff": {"type": "boolean"},
        "max_risk_level": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "evidence_gap_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "jurisdiction": {"type": "string"}
      }
    },
    "decision": {
      "type": "string",
      "enum": ["ALLOW", "MODIFY", "DEFER", "DENY", "STEP_UP", "HALT"]
    },
    "signature": {"type": "string"}
  }
}
