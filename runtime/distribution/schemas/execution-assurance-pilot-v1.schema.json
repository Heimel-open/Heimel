{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valo.example/schemas/execution-assurance-pilot-v1.schema.json",
  "title": "ExecutionAssurancePilotV1",
  "description": "Buyer-facing bounded pilot contract for observing and optionally governing one consequence-bearing workflow. Packaging only; runtime authority remains in canonical components.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pilot_id",
    "offer",
    "scope",
    "deployment",
    "runtime_components",
    "evidence_contract",
    "outputs",
    "metrics",
    "acceptance_criteria",
    "rollback",
    "commercial_boundaries"
  ],
  "properties": {
    "schema_version": {"const": "execution-assurance-pilot.v1"},
    "pilot_id": {"type": "string", "minLength": 1},
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "state", "platform_identity", "authorization_primitive"],
      "properties": {
        "name": {"const": "Execution Assurance Pilot"},
        "state": {"const": "PILOT_OFFER"},
        "platform_identity": {"const": "VALO"},
        "authorization_primitive": {"const": "REHT"}
      }
    },
    "customer_ref": {"type": ["string", "null"]},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant", "environment", "workflow", "subject", "action_class", "integration_boundary", "out_of_scope"],
      "properties": {
        "tenant": {"type": "string", "minLength": 1},
        "environment": {"type": "string", "minLength": 1},
        "workflow": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1},
        "action_class": {"type": "string", "minLength": 1},
        "integration_boundary": {"type": "string", "minLength": 1},
        "out_of_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial_mode", "allowed_progression", "safe_default", "shadow_invariants", "enforce_gate"],
      "properties": {
        "initial_mode": {"const": "shadow"},
        "allowed_progression": {
          "type": "array",
          "const": ["shadow", "recommend", "enforce"]
        },
        "safe_default": {"enum": ["observe", "shadow"]},
        "shadow_invariants": {
          "type": "object",
          "additionalProperties": false,
          "required": ["non_authoritative", "can_issue_clearance", "external_effect_performed"],
          "properties": {
            "non_authoritative": {"const": true},
            "can_issue_clearance": {"const": false},
            "external_effect_performed": {"const": false}
          }
        },
        "enforce_gate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["automatic_promotion", "single_step_only", "separation_of_duties", "required_evidence"],
          "properties": {
            "automatic_promotion": {"const": false},
            "single_step_only": {"const": true},
            "separation_of_duties": {"const": true},
            "required_evidence": {
              "type": "array",
              "minItems": 6,
              "contains": {"const": "mode_promotion_case"},
              "items": {
                "enum": [
                  "mode_promotion_case",
                  "owner",
                  "independent_approver",
                  "mandate_ref",
                  "evaluation_summary",
                  "rollback_plan",
                  "rollback_trigger",
                  "valid_until",
                  "receipt_ref"
                ]
              },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "runtime_components": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component", "canonical_repo", "role", "pin_required"],
        "properties": {
          "component": {"enum": ["shadow_runtime", "reht", "racs", "gateway", "veritas", "vaig"]},
          "canonical_repo": {"type": "string", "pattern": "^nsolland/[A-Za-z0-9_.-]+$"},
          "role": {"type": "string", "minLength": 1},
          "pin_required": {"const": true},
          "artifact_ref": {"type": ["string", "null"]}
        }
      }
    },
    "evidence_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_inputs", "correlation_fields", "freshness_required", "unknown_is_valid"],
      "properties": {
        "required_inputs": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "proposed_action",
              "actor_identity",
              "authority_state",
              "purpose",
              "resource_or_world_state",
              "policy_or_constraints",
              "human_action_or_outcome"
            ]
          }
        },
        "correlation_fields": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {"enum": ["tenant_id", "task_id", "action_id", "decision_ref", "receipt_ref"]}
        },
        "freshness_required": {"const": true},
        "unknown_is_valid": {"const": true}
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shadow", "enforce_if_approved"],
      "properties": {
        "shadow": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["ShadowEvaluation", "OutcomeAgreementRecord", "PolicyReplayResult", "pilot_metrics_report"]}
        },
        "enforce_if_approved": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {"enum": ["reht_clearance", "racs_decision", "gateway_effect_record", "veritas_execution_receipt", "outcome_observation"]}
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "in_scope_action_coverage",
          "evidence_completeness",
          "agreement_rate",
          "mismatch_rate",
          "escalation_miss_rate",
          "escalation_false_rate",
          "decision_latency",
          "shadow_external_effect_count",
          "uncorrelated_record_count",
          "unknown_or_insufficient_evidence_rate"
        ]
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shadow_disable", "enforce_fallback", "customer_system_remains_authoritative", "data_export_required"],
      "properties": {
        "shadow_disable": {"const": "remove_or_disable_observer_without_affecting_customer_execution"},
        "enforce_fallback": {"enum": ["shadow", "observe"]},
        "customer_system_remains_authoritative": {"const": true},
        "data_export_required": {"const": true}
      }
    },
    "commercial_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valo_is_product", "reht_is_product", "pilot_is_packaged_offer", "new_core_allowed", "provider_lock_in_allowed"],
      "properties": {
        "valo_is_product": {"const": false},
        "reht_is_product": {"const": false},
        "pilot_is_packaged_offer": {"const": true},
        "new_core_allowed": {"const": false},
        "provider_lock_in_allowed": {"const": false}
      }
    }
  }
}
