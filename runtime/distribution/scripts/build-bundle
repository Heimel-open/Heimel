#!/usr/bin/env python3
"""build-bundle — assemble a profile-scoped distribution bundle.

Reads a deployable component lock plus profiles/<profile>.yaml, verifies the lock,
selects exactly the profile components and materializes packaging metadata from the
pinned image+digest identities. No component source is fetched or modified.

This produces an unsigned bundle. Signing remains a separate release step.
"""
import argparse
import hashlib
import json
import os
import shutil
import subprocess
import sys

import yaml


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(8192), b""):
            h.update(chunk)
    return "sha256:" + h.hexdigest()


def load_yaml(path):
    with open(path, encoding="utf-8") as f:
        return yaml.safe_load(f)


def pinned_image(component):
    """Return tag+digest identity; digest makes the deployed bytes immutable."""
    return f"{component['image']}@{component['digest']}"


def select_components(manifest, profile):
    by_name = {c["name"]: c for c in manifest.get("components", [])}
    selected = []
    missing = []
    for requested in profile.get("components", []):
        name = requested["name"]
        component = by_name.get(name)
        if component is None:
            if requested.get("required", False):
                missing.append(name)
            continue
        selected.append(component)
    if missing:
        raise ValueError(f"required profile components missing from manifest: {missing}")
    return selected


def materialize_compose(path, selected, profile_name):
    services = {}
    for component in selected:
        services[component["name"]] = {
            "image": pinned_image(component),
            "labels": {
                "valo.distribution.profile": profile_name,
                "valo.distribution.source_sha": component["sha"],
                "valo.distribution.release_tag": component["tag"],
            },
        }
    payload = {
        "version": "3.8",
        "services": services,
    }
    with open(path, "w", encoding="utf-8") as f:
        yaml.safe_dump(payload, f, sort_keys=True)


def materialize_helm_values(path, selected, profile_name):
    components = {}
    for component in selected:
        components[component["name"]] = {
            "image": component["image"],
            "digest": component["digest"],
            "sourceSha": component["sha"],
            "releaseTag": component["tag"],
        }
    payload = {"profile": profile_name, "components": components}
    with open(path, "w", encoding="utf-8") as f:
        yaml.safe_dump(payload, f, sort_keys=True)


def materialize_packaging(out, packaging, selected, profile_name):
    generated = []
    for pkg in packaging:
        if pkg == "compose":
            dst = os.path.join(out, "compose")
            os.makedirs(dst, exist_ok=True)
            path = os.path.join(dst, f"{profile_name}.yaml")
            materialize_compose(path, selected, profile_name)
            generated.append(path)
        elif pkg == "helm":
            dst = os.path.join(out, "helm")
            os.makedirs(dst, exist_ok=True)
            path = os.path.join(dst, f"{profile_name}.yaml")
            materialize_helm_values(path, selected, profile_name)
            generated.append(path)
        else:
            src = os.path.join(pkg, f"{profile_name}.yaml")
            if not os.path.exists(src):
                raise ValueError(f"unsupported/unmaterialized packaging target: {pkg}")
            dst = os.path.join(out, pkg)
            os.makedirs(dst, exist_ok=True)
            path = os.path.join(dst, f"{profile_name}.yaml")
            shutil.copy(src, path)
            generated.append(path)
    return generated


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--profile", required=True)
    ap.add_argument("--out", default="dist")
    ap.add_argument("--manifest", default="components/components.lock.yaml")
    ap.add_argument("--validate", default="scripts/validate-distribution")
    ap.add_argument("--gates", default="validation/release-gates.yaml")
    args = ap.parse_args()

    profile_path = f"profiles/{args.profile}.yaml"
    if not os.path.exists(profile_path):
        print(f"PROFILE_NOT_FOUND: {profile_path}")
        sys.exit(2)

    manifest = load_yaml(args.manifest)
    profile = load_yaml(profile_path)
    if manifest.get("profile") != args.profile:
        print(
            f"PROFILE_MISMATCH: manifest={manifest.get('profile')} requested={args.profile}"
        )
        sys.exit(1)
    if profile.get("profile") != args.profile:
        print(
            f"PROFILE_CONTRACT_MISMATCH: profile_file={profile.get('profile')} requested={args.profile}"
        )
        sys.exit(1)

    # Validate release pins first.
    r = subprocess.run(
        [
            sys.executable,
            args.validate,
            "--manifest",
            args.manifest,
            "--bundle",
            "n/a",
            "--profile",
            args.profile,
            "--gates",
            args.gates,
        ]
    )
    if r.returncode != 0:
        print("BUILD_ABORTED: validation failed")
        sys.exit(1)

    try:
        selected = select_components(manifest, profile)
    except ValueError as exc:
        print(f"BUILD_ABORTED: {exc}")
        sys.exit(1)

    out = os.path.join(args.out, args.profile)
    os.makedirs(out, exist_ok=True)

    # Write a profile-scoped immutable manifest, not the entire global lock.
    scoped_manifest = dict(manifest)
    scoped_manifest["profile"] = args.profile
    scoped_manifest["components"] = selected
    manifest_out = os.path.join(out, "manifest.yaml")
    with open(manifest_out, "w", encoding="utf-8") as f:
        yaml.safe_dump(scoped_manifest, f, sort_keys=False)

    shutil.copy(profile_path, os.path.join(out, "profile.yaml"))

    try:
        generated_packaging = materialize_packaging(
            out, profile.get("packaging", []), selected, args.profile
        )
    except ValueError as exc:
        print(f"BUILD_ABORTED: {exc}")
        sys.exit(1)

    # Materialized SBOM/provenance evidence for the exact selected pins.
    sbom = {
        "profile": args.profile,
        "components": [
            {
                "name": c["name"],
                "repo": c["repo"],
                "tag": c["tag"],
                "source_sha": c["sha"],
                "image": c["image"],
                "digest": c["digest"],
            }
            for c in selected
        ],
    }
    sbom_path = os.path.join(out, "sbom.json")
    with open(sbom_path, "w", encoding="utf-8") as f:
        json.dump(sbom, f, indent=2, sort_keys=True)

    provenance = {
        "manifest": "manifest.yaml",
        "manifest_hash": sha256_file(manifest_out),
        "profile": "profile.yaml",
        "profile_hash": sha256_file(os.path.join(out, "profile.yaml")),
        "packaging": [
            {
                "path": os.path.relpath(path, out),
                "hash": sha256_file(path),
            }
            for path in generated_packaging
        ],
        "signed": False,
    }
    provenance_path = os.path.join(out, "provenance.json")
    with open(provenance_path, "w", encoding="utf-8") as f:
        json.dump(provenance, f, indent=2, sort_keys=True)

    bundle_hash = sha256_file(manifest_out)
    print(
        f"BUNDLE_BUILT profile={args.profile} components={len(selected)} "
        f"out={out} hash={bundle_hash}"
    )
    sys.exit(0)


if __name__ == "__main__":
    main()
