#!/usr/bin/env python3
"""validate-distribution — run release gates against a bundle + manifest.

Consumes only pinned artifacts (components.lock.yaml) and the profile. Does NOT
fetch or modify any component source. Exits non-zero on any gate failure.

This validator proves the local manifest contract only. It MUST NOT treat a
syntactically valid placeholder as a deployable artifact. Remote release/image
existence is separate evidence and must be established before a lock is promoted.
"""
import argparse
import sys
import yaml


ZERO_SHA = "0" * 40
ZERO_DIGEST = "sha256:" + "0" * 64
PLACEHOLDER_TAGS = {"v0.0.0", "0.0.0"}

# Canonical repository identities for the component names currently supported by
# the distribution manifest. This is drift protection, not runtime ownership.
CANONICAL_REPOS = {
    "reht": "nsolland/valo-reht",
    "vaig": "nsolland/VAIG",
    "veritas": "nsolland/Veritas",
    "gateway": "nsolland/valo-gateway",
    "racs": "nsolland/Racs",
    "speider": "nsolland/speider",
    "baro": "nsolland/Baro",
}


def load_gates(path):
    with open(path, encoding="utf-8") as f:
        return yaml.safe_load(f)


def load_manifest(path):
    with open(path, encoding="utf-8") as f:
        return yaml.safe_load(f)


def gate_pins_present(manifest):
    """Every component must have tag + sha + digest + image."""
    missing = []
    for c in manifest.get("components", []):
        if not all(k in c and c[k] for k in ("tag", "sha", "digest", "image")):
            missing.append(c.get("name", "?"))
    return not missing, missing


def gate_digest_format(manifest):
    bad = []
    for c in manifest.get("components", []):
        d = c.get("digest", "")
        if not (d.startswith("sha256:") and len(d) == 71 and all(ch in "0123456789abcdef" for ch in d[7:])):
            bad.append(c.get("name", "?"))
    return not bad, bad


def gate_sha_format(manifest):
    bad = []
    for c in manifest.get("components", []):
        s = c.get("sha", "")
        if not (len(s) == 40 and all(ch in "0123456789abcdef" for ch in s)):
            bad.append(c.get("name", "?"))
    return not bad, bad


def gate_no_placeholders(manifest):
    """Reject pins that only satisfy syntax while carrying no artifact identity."""
    bad = []
    for c in manifest.get("components", []):
        reasons = []
        if c.get("tag") in PLACEHOLDER_TAGS:
            reasons.append("placeholder_tag")
        if c.get("sha") == ZERO_SHA:
            reasons.append("zero_sha")
        if c.get("digest") == ZERO_DIGEST:
            reasons.append("zero_digest")
        if reasons:
            bad.append({"name": c.get("name", "?"), "reasons": reasons})
    return not bad, bad


def gate_canonical_repo_refs(manifest):
    """Reject known component-name → repository ownership drift."""
    bad = []
    for c in manifest.get("components", []):
        name = c.get("name")
        expected = CANONICAL_REPOS.get(name)
        if expected is not None and c.get("repo") != expected:
            bad.append({"name": name, "repo": c.get("repo"), "expected": expected})
    return not bad, bad


GATES = {
    "pins_present": gate_pins_present,
    "digest_format": gate_digest_format,
    "sha_format": gate_sha_format,
    "no_placeholders": gate_no_placeholders,
    "canonical_repo_refs": gate_canonical_repo_refs,
}


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--manifest", required=True)
    ap.add_argument("--bundle", required=True)
    ap.add_argument("--profile", required=True)
    ap.add_argument("--gates", default="validation/release-gates.yaml")
    args = ap.parse_args()

    manifest = load_manifest(args.manifest)
    gate_cfg = load_gates(args.gates)
    enabled = gate_cfg.get("gates", [])

    failures = []
    for g in enabled:
        fn = GATES.get(g)
        if not fn:
            print(f"GATE_UNKNOWN: {g}")
            failures.append(g)
            continue
        ok, detail = fn(manifest)
        status = "PASS" if ok else "FAIL"
        print(f"GATE {g}: {status} {detail if not ok else ''}")
        if not ok:
            failures.append(g)

    if failures:
        print(f"VALIDATION_FAILED: {failures}")
        sys.exit(1)
    print("VALIDATION_PASSED")
    sys.exit(0)


if __name__ == "__main__":
    main()
