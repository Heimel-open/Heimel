{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valo.example/schemas/factory-loop/learner_handoff_v1.schema.json",
  "title": "LearnerHandoffV1",
  "description": "Learner output. Emits provenance-bound expertise proposals and follow-up observations only; never policy, authority or activation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "handoff_id", "attempt_id", "run_id", "repository",
    "base_sha", "candidate_sha", "actor", "created_at", "proposals",
    "observations", "gates_passed", "proposal_digest", "content_digest"
  ],
  "properties": {
    "schema_version": {"const": "factory-loop-v1"},
    "handoff_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "actor": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "proposals": {"type": "array", "items": {"type": "object"}},
    "observations": {"type": "array", "items": {"type": "object"}},
    "gates_passed": {"type": "array", "items": {"type": "string"}},
    "proposal_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
