{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valo.example/schemas/factory-loop/behavior_spec_v1.schema.json",
  "title": "BehaviorSpecV1",
  "description": "Shaping artifact: the expected behavior rules for the delivery.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "spec_id", "run_id", "repository", "base_sha", "actor",
    "created_at", "behavior_rules", "content_digest"
  ],
  "properties": {
    "schema_version": {"const": "factory-loop-v1"},
    "spec_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "actor": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "behavior_rules": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
