{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valo.example/schemas/factory-loop/merge_candidate_v1.schema.json",
  "title": "MergeCandidateV1",
  "description": "Immutable merge candidate binding every evidence digest and the exact candidate SHA. Invalidates on target/head drift.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "candidate_id", "attempt_id", "run_id", "repository",
    "base_sha", "candidate_sha", "actor", "created_at", "status",
    "evidence_digests", "review_digests", "learner_digest", "content_digest"
  ],
  "properties": {
    "schema_version": {"const": "factory-loop-v1"},
    "candidate_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "actor": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["PENDING", "LANDED", "INVALID"]},
    "evidence_digests": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "review_digests": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "learner_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
