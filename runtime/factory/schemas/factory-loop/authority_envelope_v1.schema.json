{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valo.example/schemas/factory-loop/authority_envelope_v1.schema.json",
  "title": "AuthorityEnvelopeV1",
  "description": "Separate from the shaping layers. Binds authority basis, scope, base SHA, mode and expiry to execution. Authority fields are data; they never authorize by themselves.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "envelope_id", "run_id", "repository", "base_sha",
    "actor", "issued_at", "expires_at", "authority_basis", "scope", "status",
    "mode", "content_digest"
  ],
  "properties": {
    "schema_version": {"const": "factory-loop-v1"},
    "envelope_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "actor": {"type": "string", "minLength": 1},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"anyOf": [{"const": ""}, {"type": "string", "format": "date-time"}]},
    "authority_basis": {"type": "string", "minLength": 1},
    "scope": {"type": "array", "items": {"type": "string"}},
    "status": {"const": "valid"},
    "mode": {"const": "NORMAL"},
    "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
