{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valo.example/schemas/factory-loop/technical_approach_v1.schema.json",
  "title": "TechnicalApproachV1",
  "description": "Shaping artifact: the proposed technical approach.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "approach_id", "run_id", "repository", "base_sha",
    "actor", "created_at", "approach", "content_digest"
  ],
  "properties": {
    "schema_version": {"const": "factory-loop-v1"},
    "approach_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "actor": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "approach": {"type": "string", "minLength": 1},
    "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
