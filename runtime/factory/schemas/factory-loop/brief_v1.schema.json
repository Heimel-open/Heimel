{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valo.example/schemas/factory-loop/brief_v1.schema.json",
  "title": "BriefV1",
  "description": "Shaping artifact: the bounded objective and acceptance criteria.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "brief_id", "run_id", "repository", "base_sha", "actor",
    "created_at", "objective", "acceptance_criteria", "content_digest"
  ],
  "properties": {
    "schema_version": {"const": "factory-loop-v1"},
    "brief_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "actor": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "objective": {"type": "string", "minLength": 1},
    "acceptance_criteria": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
