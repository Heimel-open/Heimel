{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valoresearch.org/schemas/model-admission-record.v1.json",
  "title": "VALO Model Admission Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "model_id",
    "artifact_digest",
    "candidate_id",
    "candidate_receipt_digest",
    "pep_handoff_digest",
    "execution_receipt_digest",
    "workspace_digest",
    "state_digest",
    "dataset_digest",
    "provenance",
    "engine_id",
    "engine_commit",
    "runtime_digest",
    "evaluation_ref",
    "evaluation_evidence_digest",
    "mal_decision_ref",
    "domain",
    "exclusions",
    "owner",
    "risk_owner",
    "review_date",
    "state"
  ],
  "properties": {
    "contract": {"const": "valo.model-admission-record.v1"},
    "model_id": {"type": "string", "minLength": 1},
    "artifact_digest": {"$ref": "#/$defs/digest"},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate_receipt_digest": {"$ref": "#/$defs/digest"},
    "pep_handoff_digest": {"$ref": "#/$defs/digest"},
    "execution_receipt_digest": {"$ref": "#/$defs/digest"},
    "workspace_digest": {"$ref": "#/$defs/digest"},
    "state_digest": {"$ref": "#/$defs/digest"},
    "dataset_digest": {"$ref": "#/$defs/digest"},
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/digest"}
    },
    "engine_id": {"type": "string", "minLength": 1},
    "engine_commit": {"type": "string", "minLength": 1},
    "runtime_digest": {"$ref": "#/$defs/digest"},
    "evaluation_ref": {"type": "string", "minLength": 1},
    "evaluation_evidence_digest": {"$ref": "#/$defs/digest"},
    "mal_decision_ref": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "exclusions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "owner": {"type": "string", "minLength": 1},
    "risk_owner": {"type": "string", "minLength": 1},
    "review_date": {"type": "string", "minLength": 1},
    "state": {"const": "ADMITTED"}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
