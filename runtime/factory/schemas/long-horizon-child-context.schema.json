{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valo.example/schemas/long-horizon-child-context.schema.json",
  "title": "VALO Long Horizon Child Context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "parent_run_id",
    "child_id",
    "role",
    "mission",
    "owned_files",
    "worker_id",
    "provider_id",
    "sandbox_id",
    "authority_effect"
  ],
  "properties": {
    "schema": {"const": "valo.long-horizon.child-context.v1"},
    "parent_run_id": {"type": "string", "minLength": 1},
    "child_id": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "mission": {"type": "string", "minLength": 1},
    "owned_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "worker_id": {"type": "string", "minLength": 1},
    "provider_id": {"type": "string", "minLength": 1},
    "sandbox_id": {"type": "string", "minLength": 1},
    "authority_effect": {"const": "none"}
  }
}
