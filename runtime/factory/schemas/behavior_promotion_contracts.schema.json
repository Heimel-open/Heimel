{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "behavior-promotion-contracts.v1",
  "title": "Behavior promotion request and receipt contracts",
  "$defs": {
    "BehaviorPromotionRequestV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id", "behavior_id", "behavior_digest", "base_behavior_digest",
        "evaluation_digest", "promotion_request_digest", "author_id", "evaluator_id",
        "promoter_id", "target_scope", "authorized_scope", "target_agents",
        "environment", "repository", "commit_sha", "policy_version",
        "authority_record_digest", "risk_class", "evaluation_passed",
        "expected_role", "prohibited_behaviors", "role_evidence_refs",
        "observed_prohibited_behaviors", "baseline_terminal_score",
        "terminal_score", "baseline_role_conformance_score",
        "role_conformance_score", "role_conformance_passed", "role_anchor_mode",
        "issued_at", "expires_at", "attestation_signature"
      ],
      "properties": {
        "request_id": {"type": "string", "minLength": 1},
        "behavior_id": {"type": "string", "minLength": 1},
        "behavior_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "base_behavior_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "evaluation_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "promotion_request_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "author_id": {"type": "string", "minLength": 1},
        "evaluator_id": {"type": "string", "minLength": 1},
        "promoter_id": {"type": "string", "minLength": 1},
        "target_scope": {"enum": ["local", "agent", "role", "shared", "organization"]},
        "authorized_scope": {"enum": ["local", "agent", "role", "shared", "organization"]},
        "target_agents": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "environment": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "minLength": 3},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "policy_version": {"type": "string", "minLength": 1},
        "authority_record_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "risk_class": {"enum": ["A", "B", "C"]},
        "evaluation_passed": {"type": "boolean"},
        "expected_role": {"type": "string", "minLength": 1},
        "prohibited_behaviors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "role_evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(receipt:.+|sha256:[0-9a-f]{64})$"}},
        "observed_prohibited_behaviors": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "baseline_terminal_score": {"type": "number", "minimum": 0, "maximum": 1},
        "terminal_score": {"type": "number", "minimum": 0, "maximum": 1},
        "baseline_role_conformance_score": {"type": "number", "minimum": 0, "maximum": 1},
        "role_conformance_score": {"type": "number", "minimum": 0, "maximum": 1},
        "role_conformance_passed": {"type": "boolean"},
        "role_anchor_mode": {"enum": ["disabled", "experimental_training_control"]},
        "issued_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "attestation_signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "human_clearance_principal": {"type": ["string", "null"]},
        "human_clearance_digest": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}]},
        "touches_authority": {"type": "boolean"},
        "touches_policy": {"type": "boolean"},
        "touches_credentials": {"type": "boolean"},
        "touches_execution_boundary": {"type": "boolean"},
        "touches_reht_racs": {"type": "boolean"},
        "permits_self_attestation": {"type": "boolean"}
      }
    },
    "BehaviorPromotionReceiptV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "sequence", "receipt_id", "request_id", "behavior_id",
        "current_state", "next_state", "executed", "reason", "behavior_digest",
        "repository", "commit_sha", "target_scope", "environment", "policy_version",
        "authority_record_digest", "occurred_at", "previous_receipt_hash", "receipt_hash",
        "evaluation_digest", "evaluation_passed", "expected_role",
        "prohibited_behaviors", "role_evidence_refs", "observed_prohibited_behaviors",
        "baseline_terminal_score", "terminal_score",
        "baseline_role_conformance_score", "role_conformance_score",
        "role_conformance_passed", "role_anchor_mode"
      ],
      "properties": {
        "schema_version": {"const": "behavior-promotion-receipt.v1"},
        "sequence": {"type": "integer", "minimum": 1},
        "receipt_id": {"type": "string", "minLength": 1},
        "request_id": {"type": "string", "minLength": 1},
        "behavior_id": {"type": "string", "minLength": 1},
        "current_state": {"type": "string", "minLength": 1},
        "next_state": {"type": "string", "minLength": 1},
        "executed": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1},
        "behavior_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "repository": {"type": "string", "minLength": 3},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "target_scope": {"type": "string", "minLength": 1},
        "environment": {"type": "string", "minLength": 1},
        "policy_version": {"type": "string", "minLength": 1},
        "authority_record_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "evaluation_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "evaluation_passed": {"type": "boolean"},
        "expected_role": {"type": "string", "minLength": 1},
        "prohibited_behaviors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "role_evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(receipt:.+|sha256:[0-9a-f]{64})$"}},
        "observed_prohibited_behaviors": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "baseline_terminal_score": {"type": "number", "minimum": 0, "maximum": 1},
        "terminal_score": {"type": "number", "minimum": 0, "maximum": 1},
        "baseline_role_conformance_score": {"type": "number", "minimum": 0, "maximum": 1},
        "role_conformance_score": {"type": "number", "minimum": 0, "maximum": 1},
        "role_conformance_passed": {"type": "boolean"},
        "role_anchor_mode": {"enum": ["disabled", "experimental_training_control"]},
        "occurred_at": {"type": "string", "format": "date-time"},
        "previous_receipt_hash": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}]},
        "receipt_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
