{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valoresearch.org/schemas/model-candidate-receipt.v1.json",
  "title": "VALO Model Candidate Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "candidate_id",
    "artifact_digest",
    "pep_handoff_digest",
    "execution_receipt_digest",
    "workspace_digest",
    "state_digest",
    "dataset_digest",
    "provenance",
    "engine_id",
    "engine_commit",
    "runtime_digest",
    "objective",
    "output_name",
    "state"
  ],
  "properties": {
    "contract": {"const": "valo.model-candidate-receipt.v1"},
    "candidate_id": {"type": "string", "minLength": 1},
    "artifact_digest": {"$ref": "#/$defs/digest"},
    "pep_handoff_digest": {"$ref": "#/$defs/digest"},
    "execution_receipt_digest": {"$ref": "#/$defs/digest"},
    "workspace_digest": {"$ref": "#/$defs/digest"},
    "state_digest": {"$ref": "#/$defs/digest"},
    "dataset_digest": {"$ref": "#/$defs/digest"},
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/digest"}
    },
    "engine_id": {"type": "string", "minLength": 1},
    "engine_commit": {"type": "string", "minLength": 1},
    "runtime_digest": {"$ref": "#/$defs/digest"},
    "objective": {"type": "string", "minLength": 1},
    "output_name": {"type": "string", "minLength": 1},
    "state": {"const": "CANDIDATE"}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
