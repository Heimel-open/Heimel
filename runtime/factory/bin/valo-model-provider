#!/usr/bin/env python3
"""Provider-neutral OpenAI-compatible model adapter.

The adapter owns transport normalization only. Workflow policy, context policy,
governance evaluation and execution authorization remain outside this module.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import sys
import time
import urllib.error
import urllib.request
from dataclasses import dataclass
from typing import Any, Mapping
from urllib.parse import urlparse


@dataclass(frozen=True)
class ProviderConfig:
    endpoint: str
    model: str
    bearer_token: str
    timeout_seconds: int = 60

    @classmethod
    def from_env(cls) -> "ProviderConfig":
        endpoint = os.environ.get("VALO_MODEL_ENDPOINT", "").rstrip("/")
        model = os.environ.get("VALO_MODEL_ID", "")
        token = os.environ.get("VALO_MODEL_BEARER_TOKEN", "")
        timeout = int(os.environ.get("VALO_MODEL_TIMEOUT_SECONDS", "60"))
        if not endpoint or not model:
            raise ValueError("VALO_MODEL_ENDPOINT and VALO_MODEL_ID are required")
        parsed = urlparse(endpoint)
        if parsed.scheme not in {"http", "https"} or not parsed.netloc:
            raise ValueError("VALO_MODEL_ENDPOINT must be an absolute HTTP(S) URL")
        if timeout < 1 or timeout > 600:
            raise ValueError("VALO_MODEL_TIMEOUT_SECONDS must be between 1 and 600")
        return cls(endpoint=endpoint, model=model, bearer_token=token, timeout_seconds=timeout)

    @property
    def chat_completions_url(self) -> str:
        return f"{self.endpoint}/chat/completions"

    @property
    def endpoint_identity(self) -> str:
        parsed = urlparse(self.endpoint)
        return f"{parsed.scheme}://{parsed.netloc}"


def canonical_json(value: Any) -> bytes:
    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode("utf-8")


def request_payload(config: ProviderConfig, request: Mapping[str, Any]) -> dict[str, Any]:
    messages = request.get("messages")
    if not isinstance(messages, list) or not messages:
        raise ValueError("request.messages must be a non-empty list")
    payload: dict[str, Any] = {"model": config.model, "messages": messages}
    for key in ("temperature", "max_tokens", "response_format", "tools", "tool_choice", "seed"):
        if key in request:
            payload[key] = request[key]
    return payload


def normalize_response(response: Mapping[str, Any]) -> dict[str, Any]:
    choices = response.get("choices")
    if not isinstance(choices, list) or not choices:
        raise ValueError("provider response has no choices")
    first = choices[0]
    message = first.get("message") if isinstance(first, Mapping) else None
    if not isinstance(message, Mapping):
        raise ValueError("provider response choice has no message")
    usage = response.get("usage") if isinstance(response.get("usage"), Mapping) else {}
    return {
        "content": message.get("content"),
        "tool_calls": message.get("tool_calls", []),
        "finish_reason": first.get("finish_reason"),
        "usage": {
            "prompt_tokens": usage.get("prompt_tokens"),
            "completion_tokens": usage.get("completion_tokens"),
            "total_tokens": usage.get("total_tokens"),
        },
        "provider_response_id": response.get("id"),
    }


def invoke(config: ProviderConfig, request: Mapping[str, Any]) -> dict[str, Any]:
    payload = request_payload(config, request)
    body = canonical_json(payload)
    headers = {"Content-Type": "application/json", "Accept": "application/json"}
    if config.bearer_token:
        headers["Authorization"] = f"Bearer {config.bearer_token}"
    http_request = urllib.request.Request(config.chat_completions_url, data=body, headers=headers, method="POST")
    started_ns = time.time_ns()
    try:
        with urllib.request.urlopen(http_request, timeout=config.timeout_seconds) as result:
            raw = result.read()
            status = result.status
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode("utf-8", errors="replace")
        raise RuntimeError(f"provider HTTP {exc.code}: {detail[:500]}") from exc
    except urllib.error.URLError as exc:
        raise RuntimeError(f"provider transport failure: {exc.reason}") from exc
    completed_ns = time.time_ns()
    response = json.loads(raw)
    normalized = normalize_response(response)
    receipt = {
        "contract": "valo.openai-compatible.chat.v1",
        "endpoint_identity": config.endpoint_identity,
        "model_id": config.model,
        "request_digest": hashlib.sha256(body).hexdigest(),
        "response_digest": hashlib.sha256(canonical_json(normalized)).hexdigest(),
        "http_status": status,
        "started_at_ns": started_ns,
        "completed_at_ns": completed_ns,
        "latency_ns": completed_ns - started_ns,
    }
    return {"result": normalized, "provider_receipt": receipt}


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--request", help="JSON request file; stdin when omitted")
    parser.add_argument("--check", action="store_true", help="validate config and request without network access")
    args = parser.parse_args()
    try:
        request = json.load(open(args.request, encoding="utf-8")) if args.request else json.load(sys.stdin)
        config = ProviderConfig.from_env()
        payload = request_payload(config, request)
        if args.check:
            print(json.dumps({"ok": True, "contract": "valo.openai-compatible.chat.v1", "payload": payload}, sort_keys=True))
        else:
            print(json.dumps(invoke(config, request), sort_keys=True, ensure_ascii=False))
        return 0
    except (ValueError, RuntimeError, json.JSONDecodeError) as exc:
        print(json.dumps({"ok": False, "error": str(exc)}), file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
