#!/usr/bin/env python3
"""valo-profile-route — advisory execution-profile selection; never executes."""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "lib"))

from execution_profile_routing import (  # noqa: E402
    ExecutionProfileRoutingError,
    request_from_dict,
    route_execution_profiles,
)


def _read_request(path: str | None) -> dict:
    if path:
        return json.loads(Path(path).read_text(encoding="utf-8"))
    if not sys.stdin.isatty():
        return json.load(sys.stdin)
    raise SystemExit("request required via --request-file or stdin")


def main() -> int:
    parser = argparse.ArgumentParser(prog="valo-profile-route")
    parser.add_argument("--request-file")
    args = parser.parse_args()

    try:
        request = request_from_dict(_read_request(args.request_file))
        receipt = route_execution_profiles(request)
    except (ExecutionProfileRoutingError, ValueError, TypeError, json.JSONDecodeError) as exc:
        print(json.dumps({
            "status": "REFUSED",
            "error": str(exc),
            "authority_effect": "none",
        }, sort_keys=True), file=sys.stderr)
        return 2

    print(json.dumps(receipt.as_dict(), indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
