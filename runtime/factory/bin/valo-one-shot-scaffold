#!/usr/bin/env python3
"""Materialize and optionally bind a local thin-app release candidate.

No git push, PR, deploy, publication, purchase or external action is performed.
The command only creates local candidate files after F0 profile compilation.

With --verify, the generated dependency-free smoke test must pass. With both
--target-source-sha and --release-version, the candidate is bound to an exact
repository SHA and deterministic artifact digest after smoke verification.
"""
from __future__ import annotations

import argparse
import json
import pathlib
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from lib.one_shot_scaffold import (  # noqa: E402
    bind_release,
    build_scaffold_plan,
    materialize,
)
from lib.portfolio_intake import AuthorityContext  # noqa: E402


def load_json(path: str) -> dict:
    return json.loads(pathlib.Path(path).read_text(encoding="utf-8"))


def authority_context(data: dict) -> AuthorityContext:
    allowed = {
        "principal",
        "issued_via",
        "authority_basis",
        "source_ref",
        "issued_at",
        "authority",
        "expires_at",
        "target_base_ref",
        "canonical_base_shas",
    }
    unknown = sorted(set(data) - allowed)
    if unknown:
        raise ValueError("authority context has unknown field(s): " + ", ".join(unknown))
    return AuthorityContext(
        principal=str(data.get("principal") or ""),
        issued_via=str(data.get("issued_via") or ""),
        authority_basis=str(data.get("authority_basis") or ""),
        source_ref=str(data.get("source_ref") or ""),
        issued_at=str(data.get("issued_at") or ""),
        authority=str(data.get("authority") or ""),
        expires_at=data.get("expires_at"),
        target_base_ref=str(data.get("target_base_ref") or "main"),
        canonical_base_shas=data.get("canonical_base_shas") or {},
    )


def verify_candidate(root: pathlib.Path) -> None:
    smoke = root / "smoke_test.py"
    if not smoke.is_file():
        raise ValueError("generated candidate has no smoke_test.py")
    proc = subprocess.run(
        [sys.executable, str(smoke)],
        cwd=root,
        capture_output=True,
        text=True,
        check=False,
    )
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout or "smoke failed").strip()
        raise ValueError(f"generated smoke failed: {detail}")


def write_release_binding(root: pathlib.Path, binding) -> pathlib.Path:
    path = root / "release-binding.json"
    path.write_text(
        json.dumps(binding.to_dict(), indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )

    candidate_path = root / "release-candidate.json"
    candidate = json.loads(candidate_path.read_text(encoding="utf-8"))
    candidate["target_source_sha"] = binding.target_source_sha
    candidate["release_version"] = binding.release_version
    candidate["artifact_digest"] = binding.artifact_digest
    candidate["state"] = "CANDIDATE_BOUND"
    candidate_path.write_text(
        json.dumps(candidate, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )
    return path


def main() -> int:
    parser = argparse.ArgumentParser(prog="valo-one-shot-scaffold")
    parser.add_argument("profile", help="PortfolioBuildProfileV1 JSON")
    parser.add_argument("authority_context", help="authenticated command-context JSON")
    parser.add_argument("--factory-profile", required=True)
    parser.add_argument("--app-slug", required=True)
    parser.add_argument("--app-title")
    parser.add_argument("--output-dir", required=True)
    parser.add_argument(
        "--verify",
        action="store_true",
        help="run the generated smoke test before returning success",
    )
    parser.add_argument(
        "--target-source-sha",
        help="exact lowercase 40-hex target repository SHA for release binding",
    )
    parser.add_argument(
        "--release-version",
        help="semantic release version; required with --target-source-sha",
    )
    args = parser.parse_args()

    if bool(args.target_source_sha) != bool(args.release_version):
        print(
            json.dumps(
                {
                    "status": "NOT_GENERATED",
                    "problem": "--target-source-sha and --release-version must be supplied together",
                    "authority_effect": "none",
                },
                indent=2,
            ),
            file=sys.stderr,
        )
        return 2

    try:
        profile = load_json(args.profile)
        context = authority_context(load_json(args.authority_context))
        plan = build_scaffold_plan(
            profile,
            context,
            factory_profile=args.factory_profile,
            app_slug=args.app_slug,
            app_title=args.app_title,
        )
        root = materialize(plan, args.output_dir)

        # Binding is only meaningful after the candidate itself passes its smoke gate.
        verified = bool(args.verify or args.target_source_sha)
        if verified:
            verify_candidate(root)

        binding = None
        binding_path = None
        if args.target_source_sha:
            binding = bind_release(
                plan,
                target_source_sha=args.target_source_sha,
                release_version=args.release_version,
            )
            binding_path = write_release_binding(root, binding)
    except (OSError, json.JSONDecodeError, TypeError, ValueError) as exc:
        print(
            json.dumps(
                {
                    "status": "NOT_GENERATED",
                    "problem": str(exc),
                    "authority_effect": "none",
                },
                indent=2,
            ),
            file=sys.stderr,
        )
        return 2

    status = "GENERATED_BOUND_RELEASE_CANDIDATE" if binding else "GENERATED_LOCAL_CANDIDATE"
    result = {
        "status": status,
        "output_dir": str(root),
        "verified": verified,
        "manifest": plan.manifest(),
        "authority_effect": "none",
    }
    if binding is not None:
        result["release_binding"] = binding.to_dict()
        result["release_binding_path"] = str(binding_path)

    print(json.dumps(result, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
