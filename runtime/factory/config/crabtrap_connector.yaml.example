# CrabTrap-compatible governed transport configuration.
# Canonical upstream anchor: brexhq/CrabTrap@ac871ccc4460249f71cfc8b55ae4ba6130351b74

connector:
  request_contract: valo.governed-egress.authorize.v1
  response_contract: valo.governed-egress.response.v1
  adapter: crabtrap
  gate_base_url: http://127.0.0.1:8082
  authorize_endpoint: /v1/authorize
  response_endpoint: /v1/evaluate-response
  health_endpoint: /healthz
  fail_mode: deny
  send_raw_headers: false
  send_raw_body_to_governance: false
  include_header_names: true
  include_body_sha256: true
  include_body_size: true
  verify_forwarded_request_digest: true
  max_request_body_bytes: 10485760
  max_response_body_bytes: 1048576

transport_policy:
  static_deny_may_block_early: true
  static_allow_is_advisory: true
  llm_judge_is_advisory: true
  llm_fallback_passthrough: false
  websocket_mode: deny
  modify_mode: block_original_and_resubmit

required_governance:
  broker_command: ./bin/valo-egress-governance-broker
  vaig_command_env: VALO_EGRESS_VAIG_COMMAND
  reht_command_env: VALO_EGRESS_REHT_COMMAND
  racs_command_env: VALO_EGRESS_RACS_COMMAND
  authority_grant: true
  request_digest_binding: true
  fail_on_missing_stage: true

response_path:
  inspection_required: true
  encoded_text_without_decode: deny
  oversized_text: deny
  prompt_injection: deny
  secret_material: redact
  sensitive_headers: strip
  production_enforcement_enabled: true

environment:
  VALO_EGRESS_BIND: 127.0.0.1
  VALO_EGRESS_PORT: "8082"
  VALO_EGRESS_GOVERNANCE_COMMAND: ./bin/valo-egress-governance-broker
  VALO_EGRESS_GOVERNANCE_TIMEOUT_SECONDS: "5"
  VALO_EGRESS_STAGE_TIMEOUT_SECONDS: "5"
  VALO_RESPONSE_MAX_TEXT_BYTES: "1048576"
