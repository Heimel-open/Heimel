# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── AI ──────────────────────────────────────────────────────────
GEMINI_API_KEY=           # Google Gemini API key (aistudio.google.com)

# ── VALO Gate (private constants — do not commit values) ────────
VALO_ALPHA=               # Coherence damping coefficient
VALO_C0=                  # Characteristic frequency constant

# ── Slack ───────────────────────────────────────────────────────
SLACK_SIGNING_SECRET=     # From Slack app settings → Basic Information
