{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heimel.example/schemas/certification-attestation-v0.1.json",
  "title": "Heimel Certified Attestation v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attestation_id",
    "implementation_name",
    "implementation_identity",
    "version_or_commit",
    "profile",
    "conformance_suite_version",
    "required_negative_cases",
    "test_result",
    "evidence_hash",
    "issued_at",
    "expires_at",
    "issuer_identity",
    "status"
  ],
  "properties": {
    "attestation_id": {"type": "string", "minLength": 1},
    "implementation_name": {"type": "string", "minLength": 1},
    "implementation_identity": {"type": "string", "minLength": 1},
    "version_or_commit": {"type": "string", "minLength": 1},
    "profile": {"type": "string", "minLength": 1},
    "conformance_suite_version": {"type": "string", "minLength": 1},
    "required_negative_cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "test_result": {"enum": ["PASS", "FAIL"]},
    "evidence_hash": {"type": "string", "minLength": 1},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "issuer_identity": {"type": "string", "minLength": 1},
    "status": {"enum": ["ACTIVE", "EXPIRED", "SUSPENDED", "REVOKED"]},
    "verification_reference": {"type": "string"},
    "notes": {"type": "string"}
  }
}
