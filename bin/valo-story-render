#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "lib"))

from story_multiformat_renderer import StoryRenderError, load_manifest, render_all  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(prog="valo-story-render", description="Render one canonical story manifest to HTML, PDF and PPTX.")
    parser.add_argument("manifest", help="path to valo.story-manifest.v1 JSON")
    parser.add_argument("--output-dir", default="dist/story", help="output directory")
    parser.add_argument("--stem", default="story", help="output basename")
    ns = parser.parse_args()
    try:
        manifest = load_manifest(ns.manifest)
        outputs = render_all(manifest, ns.output_dir, ns.stem)
    except StoryRenderError as exc:
        print(f"valo-story-render: {exc}", file=sys.stderr)
        return 2
    print(json.dumps({"source_sha256": manifest.source_sha256, "outputs": {k: str(v) for k, v in outputs.items()}}, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
