#!/usr/bin/env python3
"""CLI for the governed A2A 1.0 HTTP+JSON production adapter."""

from __future__ import annotations

import argparse
import json
import pathlib
import sys

ROOT = pathlib.Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from connectors.a2a.production import (  # noqa: E402
    A2AClientError,
    GovernedA2AClient,
    prepare_payload_and_digest,
)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--request", help="JSON request file; stdin when omitted")
    parser.add_argument(
        "--prepare",
        action="store_true",
        help="prepare extension metadata and print exact A2A payload digest without transport",
    )
    args = parser.parse_args()
    try:
        with open(args.request, encoding="utf-8") if args.request else sys.stdin as handle:
            payload = json.load(handle)
        if args.prepare:
            output = prepare_payload_and_digest(
                payload["envelope"], payload["a2a_payload"]
            )
        else:
            output = GovernedA2AClient().execute(payload)
        print(json.dumps(output, sort_keys=True, ensure_ascii=False))
        return 0
    except (
        OSError,
        json.JSONDecodeError,
        KeyError,
        A2AClientError,
        ValueError,
    ) as exc:
        print(json.dumps({"ok": False, "error": str(exc)}), file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
