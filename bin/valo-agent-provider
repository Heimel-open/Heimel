#!/usr/bin/env python3
"""valo-agent-provider — provider-neutral coding-agent runtime launcher."""
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "lib"))

from provider_agent_adapters import (  # noqa: E402
    get_spec,
    login_command,
    plan_execution,
    provider_ids,
    run,
    status,
)


def _read_prompt(args) -> str:
    if args.prompt is not None:
        return args.prompt
    if args.prompt_file is not None:
        return Path(args.prompt_file).read_text(encoding="utf-8")
    if not sys.stdin.isatty():
        return sys.stdin.read()
    raise SystemExit("prompt required via --prompt, --prompt-file, or stdin")


def cmd_providers(_args) -> int:
    payload = []
    for provider_id in provider_ids():
        spec = get_spec(provider_id)
        payload.append(
            {
                "provider_id": provider_id,
                "adapter_id": spec.adapter_id,
                "binary": spec.binary,
                "product": spec.product,
                "documentation_refs": list(spec.documentation_refs),
                "authority_effect": "none",
            }
        )
    print(json.dumps(payload, indent=2, sort_keys=True))
    return 0


def cmd_status(args) -> int:
    payload = status(args.provider).as_dict()
    print(json.dumps(payload, indent=2, sort_keys=True))
    return 0 if payload["installed"] else 2


def cmd_login(args) -> int:
    command = login_command(args.provider, headless=args.headless)
    if args.dry_run:
        print(json.dumps({
            "provider_id": args.provider,
            "command": list(command),
            "authority_effect": "none",
        }, indent=2, sort_keys=True))
        return 0
    try:
        completed = subprocess.run(list(command), check=False)
    except FileNotFoundError:
        print(
            json.dumps({
                "provider_id": args.provider,
                "error": f"{command[0]} is not installed",
                "authority_effect": "none",
            }),
            file=sys.stderr,
        )
        return 127
    return completed.returncode


def cmd_plan(args) -> int:
    prompt = _read_prompt(args)
    payload = plan_execution(
        args.provider,
        prompt,
        execution_mode=args.execution_mode,
    ).as_dict()
    print(json.dumps(payload, indent=2, sort_keys=True))
    return 0


def cmd_run(args) -> int:
    prompt = _read_prompt(args)
    receipt, result = run(
        args.provider,
        prompt,
        execution_mode=args.execution_mode,
        cwd=args.cwd,
        timeout=args.timeout,
    )
    # Provider output is preserved exactly on stdout/stderr. The receipt never
    # includes raw prompt or raw provider output.
    if result.stdout:
        sys.stdout.write(result.stdout)
        if not result.stdout.endswith("\n"):
            sys.stdout.write("\n")
    if result.stderr:
        sys.stderr.write(result.stderr)
        if not result.stderr.endswith("\n"):
            sys.stderr.write("\n")
    receipt_line = "VALO_PROVIDER_RECEIPT " + json.dumps(
        receipt.as_dict(), sort_keys=True
    )
    print(receipt_line, file=sys.stderr)
    return result.returncode


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="valo-agent-provider")
    sub = parser.add_subparsers(dest="command", required=True)

    providers_parser = sub.add_parser("providers")
    providers_parser.set_defaults(func=cmd_providers)

    status_parser = sub.add_parser("status")
    status_parser.add_argument("provider", choices=provider_ids())
    status_parser.set_defaults(func=cmd_status)

    login_parser = sub.add_parser("login")
    login_parser.add_argument("provider", choices=provider_ids())
    login_parser.add_argument(
        "--headless",
        action="store_true",
        help="use a documented headless/device flow where the provider exposes one",
    )
    login_parser.add_argument("--dry-run", action="store_true")
    login_parser.set_defaults(func=cmd_login)

    for name, func in (("plan", cmd_plan), ("run", cmd_run)):
        p = sub.add_parser(name)
        p.add_argument("provider", choices=provider_ids())
        source = p.add_mutually_exclusive_group()
        source.add_argument("--prompt")
        source.add_argument("--prompt-file")
        p.add_argument(
            "--execution-mode",
            choices=("read_only", "workspace_write"),
            default="workspace_write",
        )
        if name == "run":
            p.add_argument("--cwd", default=os.getcwd())
            p.add_argument("--timeout", type=float)
        p.set_defaults(func=func)

    return parser


def main() -> int:
    args = build_parser().parse_args()
    return int(args.func(args))


if __name__ == "__main__":
    raise SystemExit(main())
